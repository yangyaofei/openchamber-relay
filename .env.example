# ============================================================
# OpenChamber Relay — 环境配置
# 复制为 .env 后修改：cp .env.example .env
#
# 两种用法（详见 README）：
#   A. 合体模式  docker compose up -d
#      本机同时跑 OpenChamber 服务 + Relay
#   B. 纯 Relay  docker compose -f docker-compose.relay.yml up -d
#      只跑 Relay，供任意 OpenChamber 实例（桌面/服务器）接入
# ============================================================

# ---------- 镜像（默认使用 GHCR 预构建镜像，可改成本地构建标签） ----------
# OPENCHAMBER_IMAGE=ghcr.io/yangyaofei/openchamber-relay/openchamber:latest
# RELAY_IMAGE=ghcr.io/yangyaofei/openchamber-relay/relay:latest

# ========== 用法 A：合体模式（OpenChamber + Relay） ==========

# 容器 hostname（UI 中显示的机器名）
OPENCHAMBER_HOSTNAME=my-machine

# 监听地址与端口。默认只绑回环，对外暴露方式（反向代理/裸跑）见 README。
# 如需局域网直连或裸跑，改为 0.0.0.0。
OPENCHAMBER_BIND=127.0.0.1
OPENCHAMBER_PORT=23000

# OpenCode server 密码与 OpenChamber UI 密码（必填，务必修改）
OPENCODE_SERVER_PASSWORD=change-me
OPENCHAMBER_UI_PASSWORD=change-me

# 宿主机上已运行的 OpenCode server 地址。
# 容器内通过 host.docker.internal 访问宿主机（compose 已自动添加该 host）。
OPENCODE_HOST=http://host.docker.internal:4096
OPENCODE_SKIP_START=true

# 工作区目录（存放供 OpenChamber 打开的项目）
OPENCHAMBER_WORKSPACES_DIR=./workspaces

# ---------- Relay（用法 A 也会在本机起一个 Relay） ----------
RELAY_BIND=127.0.0.1
RELAY_PORT=23001

# 外网 Relay WebSocket 地址，形如 wss://your.domain.example:9527/relay/ws
# 留空则不启用外网中继。
OPENCHAMBER_RELAY_URL=

# ========== 用法 B：纯 Relay（只跑中继，无 OpenChamber） ==========
# 在公网 VPS 上部署时通常配合反向代理提供 wss；如需裸跑可改 RELAY_BIND=0.0.0.0
# RELAY_BIND=0.0.0.0
# RELAY_PORT=23001

# 是否校验 host 连接的 ECDSA P-256 签名（官方 host 始终发送签名；防 serverId 冒占，可随时开启）
RELAY_VERIFY_AUTH=false
# /health 返回 JSON 里的 service 名称（默认 openchamber-relay）
# RELAY_SERVICE_NAME=openchamber-relay
